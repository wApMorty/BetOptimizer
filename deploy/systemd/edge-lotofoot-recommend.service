[Unit]
Description=Loto Foot : séance du samedi (tickets au-dessus du seuil, journal, Discord) (edge)
Documentation=file://%h/Documents/Workspace/BetOptimizer/docs/sources.md

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sh -c 'for i in $(seq 1 30); do getent hosts prono-match.fr >/dev/null && getent hosts api.the-odds-api.com >/dev/null && exit 0; sleep 10; done; exit 1'
# Relevé frais de prono-match, puis séance : les compétitions absentes de l'archive sont relevées à 1 crédit chacune,
# lotofoot_session_credits au plus (8 par défaut), sous la garde de budget mensuelle. Pas de Restart= : relancer
# dépenserait ces crédits une seconde fois et écrirait une seconde séance.
ExecStart=%h/.local/bin/edge lotofoot recommend --notify
TimeoutStartSec=900
