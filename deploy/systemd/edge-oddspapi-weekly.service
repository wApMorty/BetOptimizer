[Unit]
Description=Test prospectif hebdomadaire de la latence française (historique OddsPapi)
Documentation=file://%h/Documents/Workspace/BetOptimizer/docs/sources.md

[Service]
Type=oneshot
# Même attente du réseau que le relevé des cotes, après un réveil du portable.
ExecStartPre=/usr/bin/sh -c 'for i in $(seq 1 30); do getent hosts api.oddspapi.io >/dev/null && exit 0; sleep 10; done; exit 1'
# 6 requêtes décomptées par passage (liste des matchs) ; l'historique est gratuit. Rapport dans ~/.local/share/edge/oddspapi-weekly/.
ExecStart=/usr/bin/python3 %h/Documents/Workspace/BetOptimizer/scripts/oddspapi/weekly.py
TimeoutStartSec=3600
