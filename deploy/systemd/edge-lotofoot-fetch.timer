[Unit]
Description=Loto Foot : relevé de la FDJ toutes les heures (dérive de la répartition, résultats, rapports)

[Timer]
# Une fois par heure, à la minute 7 (la page de la FDJ est servie avec un cache de cinq minutes).
OnCalendar=*-*-* *:07:00
# Un relevé manqué (portable en veille) n'est pas rattrapé en rafale : un seul passage au réveil.
Persistent=true

[Install]
WantedBy=timers.target
