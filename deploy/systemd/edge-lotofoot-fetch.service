[Unit]
Description=Loto Foot : relevé horaire des grilles LF7 et LF8, de la répartition FDJ et des résultats (edge, FDJ puis resultats-fdj.fr)
Documentation=file://%h/Documents/Workspace/BetOptimizer/docs/sources.md
# Un échec est signalé sur Discord, au plus une fois toutes les six heures (edge-notify-failure@.service).
OnFailure=edge-notify-failure@%n.service

[Service]
Type=oneshot
# Après un réveil du portable, le réseau peut ne pas être prêt : on attend le DNS du site de la FDJ (5 minutes au plus).
ExecStartPre=/usr/bin/sh -c 'for i in $(seq 1 30); do getent hosts www.pointdevente.parionssport.fdj.fr >/dev/null && exit 0; sleep 10; done; exit 1'
# Deux pages par passage sur la FDJ (grilles ouvertes, résultats), une toutes les 5 s ; aucun crédit. Si la FDJ échoue, repli sur
# resultats-fdj.fr (accueil, liste, et le détail des seules grilles manquantes : une vingtaine de pages au plus après une longue
# panne). Seuls les faits extraits sont archivés, jamais les pages.
ExecStart=%h/.local/bin/edge lotofoot fetch --notify
TimeoutStartSec=600
