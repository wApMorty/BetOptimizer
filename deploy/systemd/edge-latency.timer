[Unit]
Description=Test prospectif de la latence française chaque lundi à 9 h, heure de Paris

[Timer]
# Le lundi matin, les matchs du week-end sont terminés.
OnCalendar=Mon *-*-* 09:00:00 Europe/Paris
# Un lundi manqué se rattrape au réveil : la liste relit toute la période du test, aucun match n'est perdu.
Persistent=true

[Install]
WantedBy=timers.target
